# Copy to .env (never commit it) or export these in your shell.
# A variable already set in your shell wins over the same name in .env (Inspect loads .env without overriding),
# so unset stale keys in your shell, or export the values you want.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
# Optional: send a provider's calls to another endpoint (a proxy that speaks that provider's API).
# OPENAI_BASE_URL=https://<proxy>/v1
# ANTHROPIC_BASE_URL=https://<proxy>
# TOGETHER_BASE_URL=https://<proxy>/v1
# Gated Hugging Face datasets (XSTest) and the released logs
HF_TOKEN=
# Evaluation awareness, stage 2 only: an endpoint that serves the three classifier models (see its README)
EA_CLASSIFY_BASE_URL=
EA_CLASSIFY_API_KEY=
